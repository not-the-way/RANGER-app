<Window x:Class="RANGER.ClientEditingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="ClientEditingWindow" Height="350" Width="600"
        Background="{StaticResource BackgroundTheme}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFullName" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Серия и номер паспорта:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPassport" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер телефона:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtPhoneNumber" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Совершеннолетний:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="chkIsMature" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Подписан отказ от ответственности:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="chkReleaseOfLiability" Margin="5"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" Margin="5" Width="80"
                    Style="{StaticResource MainButtonStyle}"/>
            <Button Content="Отмена" Click="btnCancel_Click" Margin="5" Width="80"
                    Style="{StaticResource MainButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
