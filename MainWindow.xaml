<Window x:Class="RANGER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        Title="RANGER" Height="650" Width="1000"
        MinHeight="650" MinWidth="850"
        Background="Transparent"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <Window.Resources>
        <DataTemplate x:Key="DateTemplate">
            <TextBlock Text="{Binding Path=., StringFormat=dd.MM.yyyy}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundTheme}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.7*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Label Content="RANGER"
               Style="{StaticResource MainTitleStyle}"/>

        <!-- Выбор таблиц, хз -->
        
        <StackPanel Grid.Column="1" Grid.ColumnSpan="4"
                    Orientation="Horizontal" Margin="15 0 15 0"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
            
            <RadioButton Style="{StaticResource MenuToggleRadioButton}"
                         Content="Выдача" x:Name="IssueRBtn" Checked="IssueRBtn_Checked"/>

            <RadioButton Style="{StaticResource MenuToggleRadioButton}"
                         Content="Инвентарь" x:Name="WarehouseRBtn" Checked="WarehouseRBtn_Checked"/>
            
            <RadioButton Style="{StaticResource MenuToggleRadioButton}"
                         Content="Оружие" x:Name="FirearmsRBtn" Checked="FirearmsRBtn_Checked"/>
            
            <RadioButton Style="{StaticResource MenuToggleRadioButton}"
                         Content="Сотр." x:Name="EmployeesRBtn" Checked="EmployeesRBtn_Checked"/>

            <RadioButton Style="{StaticResource MenuToggleRadioButton}"
                         Content="Клиенты" x:Name="ClientsRBtn" Checked="ClientsRBtn_Checked"/>

        </StackPanel>

        <!-- StackPanel для кнопок изменения данных -->

        <StackPanel Grid.Row="1" Grid.ColumnSpan="5"
                    Orientation="Horizontal"
                    Margin="15 0 0 0">

            <Button x:Name="btnAdd" Content="Добавить" 
                    Click="btnAdd_Click" Margin="10"
                    Grid.Row="4" Grid.Column="0"
                    Style="{StaticResource MainButtonStyle}"/>

            <Button x:Name="btnEdit" Content="Редактировать" 
                    Click="btnEdit_Click" Margin="10"
                    Grid.Row="4" Grid.Column="1"
                    Style="{StaticResource MainButtonStyle}"/>

            <Button x:Name="btnDelete" Content="Удалить"
                    Click="btnDelete_Click" Margin="10"
                    Grid.Row="4" Grid.Column="2"
                    Style="{StaticResource MainButtonStyle}"/>

            <Button x:Name="btnRefresh" Content="Обновить"
                    Click="btnRefresh_Click" Margin="10"
                    Grid.Row="4" Grid.Column="3"
                    Style="{StaticResource MainButtonStyle}"/>
        </StackPanel>

        <!-- ListView для отображения данных (Вместо DataGrid) -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="5" Grid.Row="2"
                CornerRadius="4" BorderThickness="2" Margin="10 5 10 5"
                BorderBrush="{StaticResource MainOffsetColor}">

            <ListView Background="Transparent" x:Name="dataListView"
                      Foreground="{StaticResource MainColor}"
                      SelectionChanged="dataListView_SelectionChanged"
                      GridViewColumnHeader.Click="dataListView_GridViewColumnHeaderClick">

                <ListView.View>
                    <GridView>
                        <!-- Колонки будут динамически добавляться логикой программы -->
                    </GridView>
                </ListView.View>

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#EDE6E0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource MainColor}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDE6E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
            </ListView>

        </Border>

        <Button Margin="15" Content="Вывести в Word"
                x:Name="btnExportToWord" Click="btnExportToWord_Click"
                Style="{StaticResource MainButtonStyle}"
                Grid.Row="4" Grid.Column="1"/>

        <Button x:Name="btnExportToExcel" Content="Экспорт в Excel"
                Click="btnExportToExcel_Click" Margin="15"
                Style="{StaticResource MainButtonStyle}"
                Grid.Row="4" Grid.Column="3"/>

        <TextBlock x:Name="LoggedUserTextBox"
                 Grid.Row="5"
                 Grid.ColumnSpan="2"
                 Style="{StaticResource InfoTextBoxStyle}"
                 TextAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="15 0 0 0"/>

        <TextBlock x:Name="AccessLevelTextBox"
                 Grid.Row="5" Grid.Column="3"
                 Grid.ColumnSpan="2"
                 Style="{StaticResource InfoTextBoxStyle}"
                 TextAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0 0 15 0"/>

        

    </Grid>
</Window>
