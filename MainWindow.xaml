<Window x:Class="RANGER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        Title="RANGER" Height="650" Width="800"
        Background="Transparent"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Closed="Window_Closed">
    <Grid Background="#3c3c3c">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Label Content="RANGER"
               Style="{StaticResource MainTitleStyle}"/>

        <Border Grid.RowSpan="3" Grid.ColumnSpan="5" Grid.Row="2"
                CornerRadius="4" BorderThickness="2"
                BorderBrush="{StaticResource MainOffsetColor}">

            <DataGrid Background="Transparent">
                
            </DataGrid>
            
        </Border>
        
        <TextBox x:Name="LoggedUserTextBox"
                 Grid.Row="5"
                 Grid.ColumnSpan="2"
                 Style="{StaticResource InfoTextBoxStyle}"
                 HorizontalContentAlignment="Left"/>

        <TextBox x:Name="AccessLevelTextBox"
                 Grid.Row="5" Grid.Column="3"
                 Grid.ColumnSpan="2"
                 Style="{StaticResource InfoTextBoxStyle}"
                 HorizontalContentAlignment="Right"/>
        
    </Grid>
</Window>
