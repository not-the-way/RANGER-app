<Window x:Class="RANGER.EmployeeEditingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="EmployeeEditingWindow" Height="350" Width="600"
        Background="{StaticResource BackgroundTheme}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFullName" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Номер телефона:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPhoneNumber" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата найма:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dpEmploymentDate" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Логин:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtLogin" Margin="5"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Пароль:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="txtPassword" Margin="5">
            <PasswordBox.Style>
                <Style TargetType="PasswordBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0 0 0 2"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OffsetShadeColor1}"/>
                    <Setter Property="Foreground" Value="{StaticResource MainColor}"/>
                </Style>
            </PasswordBox.Style>
        </PasswordBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Уровень доступа:" Margin="5"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cmbAccessLevel" Margin="5">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="Manager"/>
            <ComboBoxItem Content="Warehouse"/>
            <ComboBoxItem Content="Issue"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" Margin="5" Width="80"
                    Style="{StaticResource MainButtonStyle}"/>
            <Button Content="Отмена" Click="btnCancel_Click" Margin="5" Width="80"
                    Style="{StaticResource MainButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
