<Window x:Class="RANGER.EmployeeEditingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        Title="EmployeeEditingWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFullName" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата найма:" Margin="5"/>
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpEmploymentDate" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Логин:" Margin="5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtLogin" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Пароль:" Margin="5"/>
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="txtPassword" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Уровень доступа:" Margin="5"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbAccessLevel" Margin="5">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="Manager"/>
            <ComboBoxItem Content="Warehouse"/>
            <ComboBoxItem Content="Issue"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" Margin="5" Width="80"/>
            <Button Content="Отмена" Click="btnCancel_Click" Margin="5" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
