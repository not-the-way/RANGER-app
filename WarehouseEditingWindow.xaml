<Window x:Class="RANGER.WarehouseEditingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="WarehouseEditingWindow" Height="350" Width="600"
        Background="{StaticResource BackgroundTheme}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Название предмета -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Margin="5" VerticalAlignment="Center"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtItemName" Margin="5" VerticalAlignment="Center"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <!-- Дата поставки -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата поставки:" Margin="5" VerticalAlignment="Center"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dpDeliveryDate" 
                   Margin="5" VerticalAlignment="Center"/>

        <!-- Тип склада -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип предмета:" Margin="5" VerticalAlignment="Center"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbWarehouseType" 
                 Margin="5" VerticalAlignment="Center" DisplayMemberPath="Type"/>

        <!-- Количество -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Количество:" Margin="5" VerticalAlignment="Center"
                   Style="{StaticResource InfoTextBoxStyle}"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtQuantity" Margin="5" VerticalAlignment="Center"
                 PreviewTextInput="txtQuantity_PreviewTextInput"
                 Style="{StaticResource MainTextBoxStyle}"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" 
                   Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" 
                   Margin="5" Width="80" IsDefault="True"
                    Style="{StaticResource MainButtonStyle}"/>
            <Button Content="Отмена" Click="btnCancel_Click" 
                   Margin="5" Width="80" IsCancel="True"
                    Style="{StaticResource MainButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
