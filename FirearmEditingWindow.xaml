<Window x:Class="RANGER.FirearmEditingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RANGER"
        mc:Ignorable="d"
        Title="FirearmEditingWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Серийный номер:" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtSerialNumber" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtName" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория:" Margin="5"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbCategory" Margin="5">

            <ComboBoxItem Content="Гладкоствольное огнестрельное оружие"/>
            <ComboBoxItem Content="Нарезное огнестрельное оружие"/>
            <ComboBoxItem Content="Пневматическое оружие"/>
            <ComboBoxItem Content="Травматическое оружие"/>
            <ComboBoxItem Content="Сигнальное оружие"/>

        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Состояние:" Margin="5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbCondition" Margin="5">

            <ComboBoxItem Content="Требуется техобслуживание"/>
            <ComboBoxItem Content="Пригодно для использования"/>
            
        </ComboBox>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click" Margin="5" Width="80"/>
            <Button Content="Отмена" Click="btnCancel_Click" Margin="5" Width="80"/>
        </StackPanel>
        </Grid>
</Window>
