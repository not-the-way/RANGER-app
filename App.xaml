                                      Margin="0 0 15 0"
                                      VerticalAlignment="Center"/>
                                
                            </Border>

                            <TextBlock IsHitTestVisible="False"
                               Text="Введите ваш пароль..."
                               Margin="5"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="Gray">

